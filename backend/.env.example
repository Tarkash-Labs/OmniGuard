# OmniGuard AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model name (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Fallback Configuration
FALLBACK_API_KEY=your_fallback_api_key_here
FALLBACK_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
FALLBACK_MODEL=meta/llama-3.2-90b-vision-instruct

# Server config
HOST=0.0.0.0
PORT=8000
