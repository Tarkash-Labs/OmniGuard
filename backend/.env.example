<![CDATA[# OmniGuard AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model (default: gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# Fallback model (default: gemini-3.6-flash)
# Uses the same GEMINI_API_KEY — just change the model ID to any Gemini Flash variant
FALLBACK_MODEL=gemini-3.6-flash

# Server config
HOST=0.0.0.0
PORT=8000
]]>
